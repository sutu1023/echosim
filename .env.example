# EchoSim 本地开发配置样例（仅占位值，禁止填入真实凭据并提交）
# 复制为 .env 后按需修改；make up 在缺少 .env 时会自动复制本文件。

# 宿主机发布端口。服务固定只绑定 127.0.0.1，不会暴露到局域网。
ECHOSIM_PORT=8080

# PostgreSQL 开发凭据（仅用于本机 compose 数据卷，占位值）
POSTGRES_USER=echosim
POSTGRES_PASSWORD=echosim_dev_password
POSTGRES_DB=echosim

# /health 数据库探测的整体超时（秒）。必须保证数据库不可用时 5 秒内返回 503。
HEALTH_DB_TIMEOUT_SECONDS=4

# 服务端会话绝对有效期（秒），默认 7 天。Cookie 本身是浏览器会话 Cookie，
# 不设置 Max-Age/Expires，关闭浏览器后需要重新登录。
SESSION_TTL_SECONDS=604800

# 是否为会话 Cookie 添加 Secure。本地 HTTP 保持 false；仅在 HTTPS 部署时设为 true。
SESSION_COOKIE_SECURE=false

# 后台任务租约与执行参数。
# 租约过期后由其它 worker（或重启后的同一个 worker）原子接手，旧租约令牌立即失效。
JOB_LEASE_SECONDS=6
# worker 执行中的续租间隔，必须小于 JOB_LEASE_SECONDS。
JOB_HEARTBEAT_SECONDS=2
# worker 空闲时领取任务的轮询间隔（秒）。
WORKER_POLL_INTERVAL_SECONDS=0.25
# 测试任务每步间隔（毫秒），仅用于连通性自检与验收放大窗口。
TEST_TASK_STEP_DELAY_MS=250

# 材料原件存储与解析参数。
# 单份材料字节上限（默认 20 MiB），超过即 413。
DOCUMENT_MAX_BYTES=20971520
# 单份 PDF 页数上限，超过即以“页数过多”失败。
DOCUMENT_MAX_PAGES=2000
# 分块目标长度与同一段落内的重叠长度（字符）。
DOCUMENT_CHUNK_TARGET_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=120
# 解析前的可控延迟（毫秒），仅用于验收放大慢解析窗口；生产保持 0。
DOCUMENT_INGEST_DELAY_MS=0

# 引擎联通验收配置（仅 make smoke-live 使用；默认空值表示未配置）。
# MODEL_API_BASE_URL 是 Chat Completions 兼容 API 根地址，可包含 /v1。
MODEL_API_BASE_URL=https://model.example.invalid/v1
MODEL_API_KEY=replace-with-model-key
MODEL_NAME=replace-with-model-name
MODEL_TIMEOUT_SECONDS=30
# ZEP_ACCEPTANCE_GRAPH_ID 必须是验收专用图谱的 graph_uuid。
ZEP_API_KEY=replace-with-zep-key
ZEP_API_BASE_URL=
ZEP_ACCEPTANCE_GRAPH_ID=00000000-0000-0000-0000-000000000000
GRAPH_WRITE_TIMEOUT_SECONDS=20
GRAPH_STATUS_TIMEOUT_SECONDS=10
GRAPH_INDEX_TIMEOUT_SECONDS=60
GRAPH_POLL_INTERVAL_SECONDS=3
SIMULATION_TIMEOUT_SECONDS=60
SMOKE_LIVE_TOTAL_TIMEOUT_SECONDS=300
