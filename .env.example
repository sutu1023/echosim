# EchoSim 本地开发配置样例（仅占位值，禁止填入真实凭据并提交）
# 复制为 .env 后按需修改；make up 在缺少 .env 时会自动复制本文件。

# 宿主机发布端口。服务固定只绑定 127.0.0.1，不会暴露到局域网。
ECHOSIM_PORT=8080

# PostgreSQL 开发凭据（仅用于本机 compose 数据卷，占位值）
POSTGRES_USER=echosim
POSTGRES_PASSWORD=echosim_dev_password
POSTGRES_DB=echosim

# /health 数据库探测的整体超时（秒）。必须保证数据库不可用时 5 秒内返回 503。
HEALTH_DB_TIMEOUT_SECONDS=4

# 服务端会话绝对有效期（秒），默认 7 天。Cookie 本身是浏览器会话 Cookie，
# 不设置 Max-Age/Expires，关闭浏览器后需要重新登录。
SESSION_TTL_SECONDS=604800

# 是否为会话 Cookie 添加 Secure。本地 HTTP 保持 false；仅在 HTTPS 部署时设为 true。
SESSION_COOKIE_SECURE=false
